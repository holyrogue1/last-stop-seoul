{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["fetchedAt", "rail", "weather", "crowd"],
  "additionalProperties": false,
  "properties": {
    "fetchedAt": { "$ref": "#/$defs/timestamp" },
    "rail": {
      "type": ["object", "null"],
      "required": ["time", "rows", "cityHall", "airport"],
      "additionalProperties": false,
      "properties": {
        "time": { "$ref": "#/$defs/timestamp" },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/train" } },
        "cityHall": { "anyOf": [{ "$ref": "#/$defs/train" }, { "type": "null" }] },
        "airport": { "anyOf": [{ "$ref": "#/$defs/train" }, { "type": "null" }] }
      }
    },
    "weather": {
      "type": ["object", "null"],
      "required": ["time", "temp", "code", "rain", "wet"],
      "additionalProperties": false,
      "properties": {
        "time": { "$ref": "#/$defs/timestamp" },
        "temp": { "type": "number" }, "code": { "type": "integer" },
        "rain": { "type": "number" }, "wet": { "type": "boolean" }
      }
    },
    "crowd": {
      "type": ["object", "null"],
      "required": ["time", "level"],
      "additionalProperties": false,
      "properties": {
        "time": { "$ref": "#/$defs/timestamp" },
        "level": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "train": {
      "type": "object",
      "required": ["time", "line", "direction", "wait"],
      "additionalProperties": false,
      "properties": {
        "time": { "$ref": "#/$defs/timestamp" },
        "line": { "type": "string" }, "direction": { "type": "string" },
        "wait": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
